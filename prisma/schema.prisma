// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Shop {
  Vamanpuri
  Amariya
}

enum User {
  employee
  admin
}

model user {
  id             Int            @id @default(autoincrement())
  name           String
  userId         String         @unique
  email          String
  hashedPassword String?
  role           User
  stock          stock[]
  record         record[]
  Bank           Bank[]
  BillHistory    BillHistory[]
  UpdatedStock   UpdatedStock[]
}

model stock {
  id          Int      @id @default(autoincrement())
  userId      String
  user        user     @relation(fields: [userId], references: [userId])
  product     String
  size        Int
  quantity    Int?
  price       Int
  lastUpdated DateTime @default(now())
  shop        Shop
}

model record {
  id            Int      @id @default(autoincrement())
  userId        String
  user          user     @relation(fields: [userId], references: [userId])
  recordName    String
  shopName      Shop?
  message       String
  amount        Int
  date          DateTime @default(now())
  paymentMethod String
}

model Bank {
  id            Int       @id @default(autoincrement())
  userId        String
  user          user      @relation(fields: [userId], references: [userId])
  amount        Int
  bank          String
  transaction   String
  paymentMethod String?
  message       String?
  date          DateTime?
}

model BillHistory {
  id                Int            @id @default(autoincrement())
  userId            String
  user              user           @relation(fields: [userId], references: [userId])
  updatedStocks     UpdatedStock[] @relation("BillHistoryUpdatedStocks")
  pdfDate           DateTime       @db.Timestamp(3)
  totalSale         Int?
  upiPayment        Int?
  discount          Int?
  breakageCash      Int?
  canteenCash       Int?
  totalDesiSale     Int?
  totalBeerSale     Int?
  salary            Int?
  shop              Shop
  rateDiff          Int?
  transportation    Int?
  rent              Int?
  totalCashReceived Int?
  records           Json?
  date              DateTime       @default(now()) @db.Timestamp(3)
}

model UpdatedStock {
  ids           Int         @id @default(autoincrement())
  userId        String
  user          user        @relation(fields: [userId], references: [userId])
  id            Int
  billHistoryId Int
  billHistory   BillHistory @relation("BillHistoryUpdatedStocks", fields: [billHistoryId], references: [id])
  product       String
  size          Int
  lastQuantity  Int
  quantity      Int
  price         Int
  lastUpdated   DateTime    @db.Timestamp(3)
  shop          String
}
